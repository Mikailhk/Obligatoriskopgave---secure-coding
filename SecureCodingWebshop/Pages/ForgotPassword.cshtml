@page
@model SecureCodingWebshop.Pages.ForgotPasswordModel

<h2>Glemt password</h2>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <p>@Model.Message</p>
}

@if (!string.IsNullOrEmpty(Model.ResetLink))
{
    <p>
        <a href="@Model.ResetLink">Klik her for at nulstille dit password</a>
    </p>
}

<div asp-validation-summary="All"></div>

<form method="post">
    <div>
        <label>Email</label>
        <input type="email" name="Email" required />
    </div>

    <button type="submit">Nulstil password</button>
</form>