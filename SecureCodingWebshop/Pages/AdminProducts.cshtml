@page
@model SecureCodingWebshop.Pages.AdminProductsModel

<h2>Administration af produkter</h2>

<h3>Tilføj produkt</h3>

<form method="post">
    <input type="text" name="Name" placeholder="Produktnavn" required />
    <input type="number" step="0.01" name="Price" placeholder="Pris" required />
    <button type="submit">Tilføj</button>
</form>

<h3>Produkter</h3>

<table>
    <tr>
        <th>Navn</th>
        <th>Pris</th>
        <th>Rediger</th>
        <th>Slet</th>
    </tr>

    @foreach (var product in Model.Products)
    {
        <tr>
            <td>@product.Name</td>
            <td>@product.Price kr.</td>

            <td>
                <form method="post" asp-page-handler="Update">
                    <input type="hidden" name="id" value="@product.Id" />

                    <input type="text"
                           name="name"
                           value="@product.Name" />

                    <input type="number"
                           step="0.01"
                           name="price"
                           value="@product.Price" />

                    <button type="submit">Rediger</button>
                </form>
            </td>

            <td>
                <form method="post" asp-page-handler="Delete">
                    <input type="hidden" name="id" value="@product.Id" />
                    <button type="submit">Slet</button>
                </form>
            </td>
        </tr>
    }
</table>