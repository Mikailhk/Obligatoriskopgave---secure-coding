@page
@model SecureCodingWebshop.Pages.ProductsModel

<h2>Produkter</h2>

<form method="get">
    <input type="text" name="search" placeholder="Søg efter produkt" />
    <button type="submit">Søg</button>
</form>

<table>
    <tr>
        <th>Navn</th>
        <th>Pris</th>
        <th>Kurv</th>
    </tr>

    @foreach (var product in Model.Products)
    {
        <tr>
            <td>@product.Name</td>
            <td>@product.Price kr.</td>
            <td>
                <form method="post">
                    <input type="hidden" name="productId" value="@product.Id" />
                    <button type="submit">Læg i kurv</button>
                </form>
            </td>
        </tr>
    }
</table>